      "sessionId": "ae6d96d7-662d-4d13-aa53-881e9254d6a5",
      "connectionId": "74e12628-d6a8-4990-bdd9-5947b2bc666a",
      "sourceSeq": 35,
      "startMs": 354180,
      "endMs": 363000,
      "text": "这个色号是热门色，黄皮白皮都能驾驭，素颜图也很提气色，完全不挑人。",
      "isFinal": true,
      "createdAt": "2026-10-14T15:14:24.559Z"
