{
  "name": "ai-live-monitor",
  "version": "0.1.0",
  "private": true,
  "description": "AI 盯播工具 - 核心全链路",
  "main": "dist/main/main/index.js",
  "build": {
    "appId": "com.local.ai-live-monitor",
    "productName": "AI盯播工具",
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/bindings/**",
      "node_modules/file-uri-to-path/**"
    ],
    "npmRebuild": false,
    "electronVersion": "33.4.11",
    "files": [
      "dist/main/**/*",
      "dist/renderer/**/*",
      "package.json",
      "!node_modules/**/prebuilds/**"
    ],
    "directories": {
      "output": "release-verify",
      "buildResources": "build"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "sign": null,
      "signAndEditExecutable": false,
      "signingHashAlgorithms": []
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "AI盯播工具-Setup-${version}.exe"
    }
  },
  "scripts": {
    "dev": "vite build --config vite.renderer.config.ts && tsc -p tsconfig.main.json && electron .",
    "dev:renderer": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.main.json --noEmit",
    "test": "node scripts/test-electron-node.js",
    "build": "vite build --config vite.renderer.config.ts && tsc -p tsconfig.main.json",
    "smoke": "electron scripts/smoke-renderer.js",
    "prepackage": "npm run typecheck && npm run build && node scripts/verify-electron-native.js",
    "package": "electron-builder",
    "abi:node": "cd node_modules/better-sqlite3 && node ../prebuild-install/bin.js -r node",
    "abi:electron": "cd node_modules/better-sqlite3 && node ../prebuild-install/bin.js -r electron -t 33.4.11"
  },
  "dependencies": {
    "better-sqlite3": "^12.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.0",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^4.3.2",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.2",
    "vite": "^5.4.8",
    "vitest": "^2.1.2"
  }
}
