{
  "name": "asr-reconnect",
  "description": "模拟 ASR 断线重连：连接 A 输出稳态后断线（code!=0），新 voice_id 重连后继续输出。验证 seq 去重按连接隔离、断线不冒充连续转写。",
  "connectionA": {
    "voice_id": "voice-demo-a",
    "messages": [
      {
        "note": "连接A稳态1",
        "raw": "{\"code\":0,\"message\":\"success\",\"voice_id\":\"voice-demo-a\",\"result\":{\"index\":0,\"slice_type\":2,\"start_time\":0,\"end_time\":2800,\"voice_text_str\":\"这款杯子保温十二小时\"}}"
      },
      {
        "note": "连接A错误：服务断开",
        "raw": "{\"code\":1006,\"message\":\"websocket connection lost\",\"voice_id\":\"voice-demo-a\"}"
      }
    ],
    "connectionId": "conn-A"
  },
  "connectionB": {
    "voice_id": "voice-demo-b",
    "messages": [
      {
        "note": "连接B重连后 index 从0重新计数（不得与连接A去重冲突）",
        "raw": "{\"code\":0,\"message\":\"success\",\"voice_id\":\"voice-demo-b\",\"result\":{\"index\":0,\"slice_type\":2,\"start_time\":0,\"end_time\":2500,\"voice_text_str\":\"现在下单还有优惠\"}}"
      }
    ],
    "connectionId": "conn-B"
  },
  "expect": {
    "segmentsA": 1,
    "segmentsB": 1,
    "reconnectState": "reconnecting"
  }
}
